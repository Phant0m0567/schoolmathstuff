<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <base href="https://gta.zip.wf/">
  <title>$GrandV - Single-file</title>
  <style>html,body{min-height:100%;margin:0}#gta-singlefile-loading{padding:2rem;color:#e5e7eb;background:#111827;font:16px system-ui,sans-serif}</style>
</head>
<body>
  <div id="gta-singlefile-loading">loading</div>
  <script id="gta-singlefile-data" type="application/octet-stream"></script>
  <script>(function() {
const DATA_ID = "gta-singlefile-data";
const HASH_PREFIX = "#gta=";
const ORIGIN = "https://gta.zip.wf";
const nativeFetch = window.fetch.bind(window);
const nativeOpen = window.open.bind(window);
const decodedAssets = new Map();
const nativeLocation = window.location;
let data = null;

function decodeBytes(asset) {
  let bytes = decodedAssets.get(asset);
  if (bytes) return bytes;
  const binary = atob(asset.data);
  bytes = new Uint8Array(binary.length);
  for (let index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index);
  decodedAssets.set(asset, bytes);
  return bytes;
}

function normalizeRoute(pathname) {
  let path;
  try {
    path = decodeURIComponent(pathname || "/");
  } catch (error) {
    return null;
  }
  return data.aliases[path] || data.aliases[path.endsWith("/") ? path.slice(0, -1) : path + "/"] || null;
}

function virtualUrlFromHash() {
  if (nativeLocation.hash.startsWith(HASH_PREFIX)) {
    try {
      return new URL(decodeURIComponent(nativeLocation.hash.slice(HASH_PREFIX.length)), ORIGIN);
    } catch (error) {
      console.error("Invalid GTA virtual URL in the single-file hash.", error);
    }
  }
  return new URL("/launcher.html", ORIGIN);
}

function assetForUrl(url) {
  if (url.origin !== data.assets.origin) return null;
  const hash = data.assets.paths[url.pathname + url.search] || data.assets.pathFallback[url.pathname];
  return hash ? data.assets.blobs[hash] : null;
}

function pathForAsset(rawUrl, baseUrl) {
  if (!rawUrl || /^(?:data:|blob:|javascript:|mailto:|tel:|#)/i.test(rawUrl.trim())) return null;
  let url;
  try {
    url = new URL(rawUrl, baseUrl);
  } catch (error) {
    return null;
  }
  if (url.origin !== data.assets.origin) return null;
  return assetForUrl(url);
}

function dataUriForPath(rawUrl, baseUrl) {
  const asset = pathForAsset(rawUrl, baseUrl);
  if (!asset) return null;
  return "data:" + asset.type + ";base64," + asset.data;
}

function rewriteCss(css, baseUrl) {
  return css.replace(/url\(\s*(?:(["'])(.*?)\1|([^)]*?))\s*\)/gi, function(match, quote, quoted, bare) {
    const raw = String(quoted || bare || "").trim();
    const dataUri = dataUriForPath(raw, baseUrl);
    return dataUri ? "url(" + JSON.stringify(dataUri) + ")" : match;
  });
}

function localizeElement(element) {
  const baseUrl = window.__GTA_VIRTUAL_LOCATION.href;
  for (const attribute of ["src", "poster", "data-src", "data-fallback-src", "href", "xlink:href"]) {
    if (attribute === "href" && element.tagName === "A") continue;
    const value = element.getAttribute(attribute);
    if (!value) continue;
    const dataUri = dataUriForPath(value, baseUrl);
    if (dataUri && dataUri !== value) element.setAttribute(attribute, dataUri);
  }
  const srcset = element.getAttribute("srcset");
  if (srcset && !/^\s*data:/i.test(srcset)) {
    const localizedSrcset = srcset.split(",").map(function(candidate) {
      const match = candidate.trim().match(/^(\S+)(\s+.*)?$/);
      if (!match) return candidate;
      return (dataUriForPath(match[1], baseUrl) || match[1]) + (match[2] || "");
    }).join(", ");
    if (localizedSrcset !== srcset) element.setAttribute("srcset", localizedSrcset);
  }
  const style = element.getAttribute("style");
  if (style) {
    const localizedStyle = rewriteCss(style, baseUrl);
    if (localizedStyle !== style) element.setAttribute("style", localizedStyle);
  }
  if (element.tagName === "STYLE") {
    const localizedCss = rewriteCss(element.textContent, baseUrl);
    if (localizedCss !== element.textContent) element.textContent = localizedCss;
  }
}

function localizeTree(root) {
  if (root.nodeType === 1) localizeElement(root);
  if (root.querySelectorAll) root.querySelectorAll("*").forEach(localizeElement);
}

function rewritePageScript(source) {
  let code = source.replace(
    /(^|[^\w$.])(?:window\.)?location\.href\s*=\s*([^;\n]+);/gm,
    "$1window.__GTA_NAVIGATE($2);"
  );
  code = code.replace(
    /(^|[^\w$.])(?:window\.)?location\.hash\s*=\s*([^;\n]+);/gm,
    "$1window.__GTA_SET_HASH($2);"
  );
  code = code.replace(
    /(^|[^\w$.])(?:window\.)?location\.(?:assign|replace)\(([^;\n]*)\)/gm,
    "$1window.__GTA_NAVIGATE($2)"
  );
  code = code.replace(
    /(^|[^\w$.])window\.location\.(pathname|search|origin|href|hash)\b/g,
    "$1window.__GTA_VIRTUAL_LOCATION.$2"
  );
  code = code.replace(
    /(^|[^\w$.])location\.(pathname|search|origin|href|hash)\b/g,
    "$1window.__GTA_VIRTUAL_LOCATION.$2"
  );
  return code.replace(
    /\bimport\s*\(\s*(["'])([^"']+)\1\s*\)/g,
    "window.__GTA_IMPORT_MODULE($1$2$1)"
  );
}

function copyAttributes(source, target) {
  Array.from(target.attributes).forEach(function(attribute) {
    if (!source.hasAttribute(attribute.name)) target.removeAttribute(attribute.name);
  });
  Array.from(source.attributes).forEach(function(attribute) {
    target.setAttribute(attribute.name, attribute.value);
  });
}

function collectScripts(root) {
  const scripts = [];
  root.querySelectorAll("script").forEach(function(script) {
    const type = (script.getAttribute("type") || "").trim().toLowerCase();
    if (!type || type === "module" || /^(?:text|application)\/(?:java|ecma)script$/.test(type)) {
      scripts.push(script);
      script.remove();
    }
  });
  return scripts;
}

function appendScript(source, target) {
  return new Promise(function(resolve) {
    const script = document.createElement("script");
    const type = (source.getAttribute("type") || "").trim().toLowerCase();
    Array.from(source.attributes).forEach(function(attribute) {
      if (attribute.name !== "src" && attribute.name !== "async" && attribute.name !== "defer") {
        script.setAttribute(attribute.name, attribute.value);
      }
    });
    const sourceUrl = source.getAttribute("src");
    if (sourceUrl) {
      const url = new URL(sourceUrl, window.__GTA_VIRTUAL_LOCATION.href);
      const asset = assetForUrl(url);
      if (asset && /javascript|ecmascript/i.test(asset.type)) {
        script.textContent = rewritePageScript(new TextDecoder().decode(decodeBytes(asset)));
        target.appendChild(script);
        resolve();
        return;
      }
      script.src = url.href;
      script.onload = resolve;
      script.onerror = function(event) {
        console.error("Failed to load a GTA page script.", url.href, event);
        resolve();
      };
      target.appendChild(script);
      return;
    }
    script.textContent = type === "application/json" || type === "application/ld+json"
      ? source.textContent
      : rewritePageScript(source.textContent);
    script.onload = resolve;
    script.onerror = function(event) {
      console.error("Failed to run an inline GTA page script.", event);
      resolve();
    };
    target.appendChild(script);
    if (type !== "module") resolve();
  });
}

async function appendScripts(scripts, target) {
  for (const script of scripts) await appendScript(script, target);
}

function toStandaloneUrl(url) {
  if (url.origin !== ORIGIN) return null;
  const route = normalizeRoute(url.pathname);
  if (!route) return null;
  const standaloneUrl = new URL(nativeLocation.href);
  standaloneUrl.hash = HASH_PREFIX + encodeURIComponent(route + url.search + url.hash);
  return standaloneUrl.href;
}

function navigate(target) {
  let url;
  try {
    url = new URL(String(target), window.__GTA_VIRTUAL_LOCATION.href);
  } catch (error) {
    console.error("Could not parse a GTA navigation target.", target, error);
    return false;
  }
  const standaloneUrl = toStandaloneUrl(url);
  if (!standaloneUrl) {
    nativeLocation.assign(url.href);
    return true;
  }
  const nextHash = new URL(standaloneUrl).hash;
  if (nextHash === nativeLocation.hash) {
    window.location.reload();
  } else {
    nativeLocation.hash = nextHash;
  }
  return true;
}

function setVirtualHash(value) {
  const next = new URL(window.__GTA_VIRTUAL_LOCATION.href);
  next.hash = String(value || "");
  navigate(next.href);
}

function installNavigation() {
  window.__GTA_NAVIGATE = navigate;
  window.__GTA_SET_HASH = setVirtualHash;
  window.__GTA_VIRTUAL_LOCATION = virtualUrlFromHash();
  window.__GTA_IMPORT_MODULE = function(target) {
    const url = new URL(String(target), window.__GTA_VIRTUAL_LOCATION.href);
    const asset = assetForUrl(url);
    if (!asset || !/javascript|ecmascript/i.test(asset.type)) return import(url.href);
    const objectUrl = URL.createObjectURL(new Blob([decodeBytes(asset)], {type: "text/javascript"}));
    return import(objectUrl).finally(function() {
      URL.revokeObjectURL(objectUrl);
    });
  };
  window.open = function(target, targetName, features) {
    if (target == null || target === "") return nativeOpen(target, targetName, features);
    let url;
    try {
      url = new URL(String(target), window.__GTA_VIRTUAL_LOCATION.href);
    } catch (error) {
      return nativeOpen(target, targetName, features);
    }
    const standaloneUrl = toStandaloneUrl(url);
    return nativeOpen(standaloneUrl || url.href, targetName, features);
  };
  document.addEventListener("click", function(event) {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const anchor = event.target.closest && event.target.closest("a[href]");
    if (!anchor || anchor.hasAttribute("download") || anchor.target && anchor.target !== "_self") return;
    let url;
    try {
      url = new URL(anchor.getAttribute("href"), window.__GTA_VIRTUAL_LOCATION.href);
    } catch (error) {
      return;
    }
    if (!toStandaloneUrl(url)) return;
    event.preventDefault();
    navigate(url.href);
  });
  window.addEventListener("hashchange", function() {
    const next = virtualUrlFromHash();
    const current = window.__GTA_VIRTUAL_LOCATION;
    if (next.pathname === current.pathname && next.search === current.search) {
      window.__GTA_VIRTUAL_LOCATION = next;
      const id = next.hash.slice(1);
      if (id) {
        const target = document.getElementById(decodeURIComponent(id));
        if (target) target.scrollIntoView();
      }
      return;
    }
    window.location.reload();
  });
}

function installResourceInterception() {
  window.fetch = function(resource, options) {
    let url;
    try {
      const input = typeof resource === "string" || resource instanceof URL ? String(resource) : resource.url;
      url = new URL(input, window.__GTA_VIRTUAL_LOCATION.href);
    } catch (error) {
      return nativeFetch(resource, options);
    }
    const asset = assetForUrl(url);
    if (!asset) return nativeFetch(typeof resource === "string" || resource instanceof URL
      ? url.href
      : new Request(url.href, resource), options);
    const method = String(options && options.method || resource && resource.method || "GET").toUpperCase();
    if (method !== "GET" && method !== "HEAD") {
      return Promise.resolve(new Response("Method not supported for embedded GTA assets.", {status: 405}));
    }
    return Promise.resolve(new Response(method === "HEAD" ? null : decodeBytes(asset), {
      status: 200,
      headers: {"Content-Type": asset.type}
    }));
  };
  const NativeWorker = window.Worker;
  if (NativeWorker) {
    function EmbeddedWorker(scriptUrl, options) {
      let url;
      try {
        url = new URL(String(scriptUrl), window.__GTA_VIRTUAL_LOCATION.href);
      } catch (error) {
        return new NativeWorker(scriptUrl, options);
      }
      const asset = assetForUrl(url);
      if (!asset || options && options.type === "module") return new NativeWorker(scriptUrl, options);
      const objectUrl = URL.createObjectURL(new Blob([decodeBytes(asset)], {type: asset.type || "text/javascript"}));
      const worker = new NativeWorker(objectUrl, options);
      const terminate = worker.terminate.bind(worker);
      worker.terminate = function() {
        URL.revokeObjectURL(objectUrl);
        return terminate();
      };
      return worker;
    }
    EmbeddedWorker.prototype = NativeWorker.prototype;
    Object.setPrototypeOf(EmbeddedWorker, NativeWorker);
    window.Worker = EmbeddedWorker;
  }
  new MutationObserver(function(records) {
    for (const record of records) {
      if (record.type === "attributes") {
        localizeElement(record.target);
      } else {
        record.addedNodes.forEach(localizeTree);
      }
    }
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["src", "poster", "data-src", "data-fallback-src", "href", "xlink:href", "srcset", "style"],
    childList: true,
    subtree: true
  });
}

async function renderPage(page) {
  const pageDocument = new DOMParser().parseFromString(
    "<!doctype html><html" + page.htmlAttributes + "><head>" + page.head +
      "</head><body" + page.bodyAttributes + ">" + page.content + "</body></html>",
    "text/html"
  );
  copyAttributes(pageDocument.documentElement, document.documentElement);
  copyAttributes(pageDocument.body, document.body);
  document.title = page.title;
  const headScripts = collectScripts(pageDocument.head);
  for (const child of Array.from(pageDocument.head.childNodes)) {
    if (child.nodeType === 1 && (child.tagName === "TITLE" || child.tagName === "BASE")) continue;
    const clone = document.importNode(child, true);
    if (clone.nodeType === 1) {
      clone.setAttribute("data-gta-page-resource", "");
      localizeTree(clone);
    }
    document.head.appendChild(clone);
  }
  const bodyScripts = collectScripts(pageDocument.body);
  const bodyNodes = Array.from(pageDocument.body.childNodes).map(function(node) {
    return document.importNode(node, true);
  });
  document.body.replaceChildren.apply(document.body, bodyNodes);
  localizeTree(document.body);
  const loading = document.getElementById("gta-singlefile-loading");
  if (loading) loading.remove();
  await appendScripts(headScripts, document.head);
  await appendScripts(bodyScripts, document.body);
}

async function start() {
  const dataElement = document.getElementById(DATA_ID);
  if (!dataElement) throw new Error("The GTA single-file data block is missing.");
  const compressed = Uint8Array.from(atob(dataElement.textContent.trim()), function(character) {
    return character.charCodeAt(0);
  });
  data = JSON.parse(new TextDecoder().decode(new Uint8Array(await new Response(
    new Blob([compressed]).stream().pipeThrough(new DecompressionStream("gzip"))
  ).arrayBuffer())));
  installNavigation();
  installResourceInterception();
  const virtualUrl = window.__GTA_VIRTUAL_LOCATION;
  const route = normalizeRoute(virtualUrl.pathname);
  if (!route || !data.pages[route]) throw new Error("The GTA route is not included in this single-file bundle: " + virtualUrl.pathname);
  await renderPage(data.pages[route]);
  document.dispatchEvent(new Event("DOMContentLoaded", {bubbles: true}));
  window.dispatchEvent(new Event("load"));
  if (virtualUrl.hash) {
    const target = document.getElementById(decodeURIComponent(virtualUrl.hash.slice(1)));
    if (target) target.scrollIntoView();
  }
}

start().catch(function(error) {
  console.error("Could not start the GTA single-file page.", error);
  document.body.innerHTML = "<pre style='padding:1rem;color:#b91c1c;white-space:pre-wrap'></pre>";
  document.body.querySelector("pre").textContent = "Could not load the embedded GTA page: " + error.message;
});
})();</script>
</body>
</html>
